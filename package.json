{
	"name": "guanatos-app",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"scripts": {
		"dev": "pnpm run build:css && (pnpm run css:watch & vite)",
		"build": "pnpm run build:css && vite build",
		"preview": "vite preview",
		"format": "prettier --write .",
		"lint": "eslint . --ext .js .jsx --fix",
		"build:css": "postcss src/assets/css/index.css -o src/assets/css/styles.css",
		"css:watch": "postcss src/assets/css/index.css -o src/assets/css/styles.css --watch"
	},
	"dependencies": {
		"@react-google-maps/api": "2.20.8",
		"axios": "1.21.1",
		"formik": "2.4.9",
		"framer-motion": "11.18.2",
		"i18next": "23.16.8",
		"prop-types": "15.8.1",
		"react": "18.3.1",
		"react-dom": "18.3.1",
		"react-i18next": "14.1.3",
		"react-router-dom": "6.30.6",
		"react-toastify": "10.0.6",
		"yup": "1.7.1"
	},
	"devDependencies": {
		"@tailwindcss/aspect-ratio": "0.4.2",
		"@types/react": "18.3.31",
		"@types/react-dom": "18.3.7",
		"@vitejs/plugin-react": "4.7.0",
		"autoprefixer": "10.6.2",
		"eslint": "8.57.1",
		"eslint-config-prettier": "9.1.2",
		"eslint-config-standard": "17.1.0",
		"eslint-plugin-import": "2.32.0",
		"eslint-plugin-n": "16.6.2",
		"eslint-plugin-promise": "6.6.0",
		"eslint-plugin-react": "7.37.5",
		"eslint-plugin-react-hooks": "4.6.2",
		"postcss": "8.5.32",
		"postcss-cli": "11.0.1",
		"prettier": "3.10.1",
		"tailwindcss": "3.4.19",
		"vite": "5.4.21"
	}
}
